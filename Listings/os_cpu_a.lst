  275 000000AE         ;                                       处理 PendSV �
                       �常
  276 000000AE         ;                                   void OS_CPU_PendSVHa
                       ndler(void)
  277 000000AE         ;
  278 000000AE         ; 注意 : 1) PendSV 用于引发上下文切换。这�
                       �在 Cortex-M 上执行上下文切换的推荐方法。
                       
  279 000000AE         ;           这是因为 Cortex-M 在任何异常上都�
                       ��自动保存一半的处理器上下文，并在异常
                       返回时恢复。
  280 000000AE         ;           因此只需要保存 R4-R11 和 R14 并调�
                       ��栈指针。以这种方式使用 PendSV 异常意味�
                       ��
  281 000000AE         ;           无论是从线程发起还是由中断或�
                       �常引起，上下文保存和恢复都是相同的。
  282 000000AE         ;
  283 000000AE         ;        2) 伪代码如下：
  284 000000AE         ;           a) 获取进程栈指针
  285 000000AE         ;           b) 在进程栈上保存剩余寄存器 r4-r
                       11 和 r14
  286 000000AE         ;           c) 将进程栈指针保存到其 TCB 中，
                       OSTCBCur->OSTCBStkPtr = SP
  287 000000AE         ;           d) 调用 OSTaskSwHook()
  288 000000AE         ;           e) 获取当前高优先级，OSPrioCur = OS
                       PrioHighRdy
  289 000000AE         ;           f) 获取当前就绪任务的 TCB，OSTCBCu
                       r = OSTCBHighRdy
  290 000000AE         ;           g) 从 TCB 获取新进程栈指针，SP = O
                       STCBHighRdy->OSTCBStkPtr
  291 000000AE         ;           h) 从新进程栈中恢复 R4-R11 和 R14
  292 000000AE         ;           i) 执行异常返回，将恢复其余上�
                       �文
  293 000000AE         ;



